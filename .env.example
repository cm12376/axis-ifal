# ==========================================
# AXIS IFAL - VARIÁVEIS DE AMBIENTE
# Copie para .env e preencha com seus valores
# ==========================================

# Banco de dados Neon PostgreSQL (obrigatório para a API serverless)
# Connection string obtida em https://neon.tech
DATABASE_URL=postgresql://usuario:senha@ep-host.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://usuario:senha@ep-host.neon.tech/dbname?sslmode=require

# Chave da API Groq para o Tutor Virtual (server-side, segura)
# Obtenha em https://console.groq.com/keys
# Serve como fallback: usada só quando o aluno não cadastrou a própria chave.
GROQ_API_KEY=

# Chave-mestra para cifrar segredos dos usuários (chave Groq de cada aluno) - AES-256-GCM
# OBRIGATÓRIA para que os alunos possam salvar a própria chave de IA.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: se esta chave mudar, as chaves já salvas no banco deixam de ser legíveis.
AXIS_ENCRYPTION_KEY=
